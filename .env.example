# Copy to .env and adjust as needed. Every value is optional.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Routing: "osrm" (default, no key) or "ors" (OpenRouteService, free key at openrouteservice.org)
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-car
ORS_API_KEY=
ORS_PROFILE=driving-hgv

# Geocoding fallback for free-form addresses
NOMINATIM_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT=fuel-route-planner/1.0 (your-email@example.com)

# Vehicle and planning defaults
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
DEFAULT_CORRIDOR_MILES=10
DEFAULT_STOP_PENALTY_USD=10

# Caching (defaults to in-process memory)
ROUTE_CACHE_SECONDS=86400
# CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
# CACHE_LOCATION=/tmp/fuelroute-cache
